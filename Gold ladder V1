import sys
import time
import heapq
from collections import deque

DIRS = [('UP',0,-1),('DOWN',0,1),('LEFT',-1,0),('RIGHT',1,0)]
INF=float('inf')

my_id=int(input())
width=int(input())
height=int(input())

base_grid=[list(input()) for _ in range(height)]

my_snakes=set()
opp_snakes=set()

snakebots_per_player=int(input())

for _ in range(snakebots_per_player):
    my_snakes.add(int(input()))

for _ in range(snakebots_per_player):
    opp_snakes.add(int(input()))

turn=0


def cell(grid,x,y):
    if x<0 or x>=width:
        return '.'
    return grid[y][x]


def next_head(body,move):
    hx,hy=body[0]
    for name,dx,dy in DIRS:
        if name==move:
            return (hx+dx,hy+dy)
    return body[0]


def is_supported(body,sgrid,eaten,all_heads,future_heads):

    bset=set(body)

    for x,y in body:

        by=y+1
        if by>=height:
            continue

        if (x,by) in bset or (x,by) in eaten:
            continue

        if (x,by) in all_heads or (x,by) in future_heads:
            continue

        if cell(sgrid,x,by) in ('#','0','o','$'):
            return True

    return False


def apply_gravity(body,sgrid,eaten,all_heads,future_heads):

    body=list(body)

    for _ in range(height+1):

        if is_supported(body,sgrid,eaten,all_heads,future_heads):
            return body

        new=[]

        for x,y in body:

            if y+1>=height:
                return None

            new.append((x,y+1))

        body=new

    return None


def void_fall_safe(body,sgrid,eaten,all_heads,future_heads):

    test=apply_gravity(body,sgrid,eaten,all_heads,future_heads)

    if test is None:
        return False

    hx,hy=test[0]

    if hy>=height-1:
        return False

    for _,dx,dy in DIRS:

        nx,ny=hx+dx,hy+dy

        if 0<=nx<width and 0<=ny<height:

            c=cell(sgrid,nx,ny)

            if c not in ('#','0','o'):
                return True

    return False


def sim_move(body,dx,dy,sgrid,eaten,all_heads,future_heads):

    hx,hy=body[0]

    nx,ny=hx+dx,hy+dy

    if ny<0 or ny>=height:
        return None,eaten

    c=cell(sgrid,nx,ny)

    if (nx,ny) in eaten:
        c='.'

    if nx<0 or nx>=width:

        test=[(nx,ny)]+list(body[:-1])

        if not void_fall_safe(test,sgrid,eaten,all_heads,future_heads):
            return None,eaten

    bset=set(body) if c=='$' else set(body[:-1])

    if c in('#','0','o') or (nx,ny) in bset:
        return None,eaten

    if c=='$':
        new_body=[(nx,ny)]+list(body)
        new_eaten=eaten|{(nx,ny)}
    else:
        new_body=[(nx,ny)]+list(body[:-1])
        new_eaten=eaten

    after=apply_gravity(new_body,sgrid,new_eaten,all_heads,future_heads)

    return after,new_eaten


def count_reachable(hx,hy,sgrid,body_set,eaten,limit):

    start=(hx,hy)

    visited={start}

    q=deque([start])

    while q and len(visited)<limit:

        x,y=q.popleft()

        for _,dx,dy in DIRS:

            nx,ny=x+dx,y+dy

            if (nx,ny) in visited or (nx,ny) in body_set:
                continue

            if ny<0 or ny>=height:
                continue

            c=cell(sgrid,nx,ny)

            if (nx,ny) in eaten:
                c='.'

            if c in('#','0','o'):
                continue

            visited.add((nx,ny))
            q.append((nx,ny))

    return len(visited)


def build_danger_map(snakes):

    danger={}

    for sid,body in snakes.items():

        if sid not in opp_snakes:
            continue

        hx,hy=body[0]

        danger[(hx,hy)]=12

        for _,dx,dy in DIRS:

            nx,ny=hx+dx,hy+dy

            if 0<=ny<height:
                danger[(nx,ny)]=danger.get((nx,ny),0)+7

    return danger


def astar(body,targets,sgrid,danger_map,all_heads,future_heads,time_budget=12):

    if not targets:
        return None,None

    t0=time.time()

    def h(pos):
        return min(abs(pos[0]-tx)+abs(pos[1]-ty) for tx,ty in targets)

    heap=[]

    counter=0

    eaten0=frozenset()

    gscore={(tuple(body),eaten0):0}

    for name,dx,dy in DIRS:

        nb,ne=sim_move(body,dx,dy,sgrid,eaten0,all_heads,future_heads)

        if nb is None:
            continue

        g=1+danger_map.get(nb[0],0)*0.4

        state=(tuple(nb),ne)

        gscore[state]=g

        counter+=1

        heapq.heappush(heap,(g+h(nb[0]),counter,g,tuple(nb),ne,name))

        if nb[0] in targets:
            return name,nb[0]

    while heap:

        if (time.time()-t0)*1000>time_budget:
            break

        _,_,g,bt,eaten,first=heapq.heappop(heap)

        body=list(bt)

        for _,dx,dy in DIRS:

            nb,ne=sim_move(body,dx,dy,sgrid,eaten,all_heads,future_heads)

            if nb is None:
                continue

            newg=g+1+danger_map.get(nb[0],0)*0.4

            state=(tuple(nb),ne)

            if newg<gscore.get(state,INF):

                gscore[state]=newg

                counter+=1

                heapq.heappush(heap,(newg+h(nb[0]),counter,newg,tuple(nb),ne,first))

            if nb[0] in targets:
                return first,nb[0]

    return None,None


def best_survival_move(body,sgrid,danger_map,all_heads,future_heads):

    best=None
    best_score=-INF

    for name,dx,dy in DIRS:

        nb,_=sim_move(body,dx,dy,sgrid,frozenset(),all_heads,future_heads)

        if nb is None:
            continue

        space=count_reachable(nb[0][0],nb[0][1],sgrid,frozenset(nb[:-1]),frozenset(),200)

        score=space-danger_map.get(nb[0],0)*3

        if score>best_score:
            best_score=score
            best=name

    return best


while True:

    turn+=1

    grid=[row[:] for row in base_grid]

    power_sources=[]

    ps_count=int(input())

    for _ in range(ps_count):

        x,y=map(int,input().split())

        power_sources.append((x,y))

        grid[y][x]='$'

    snakes={}

    sbot_count=int(input())

    for _ in range(sbot_count):

        parts=input().split()

        sid=int(parts[0])

        coords=[tuple(map(int,p.split(','))) for p in parts[1].split(':')]

        snakes[sid]=coords

        mark='0' if sid in my_snakes else 'o'

        for x,y in coords:

            if 0<=x<width and 0<=y<height:
                grid[y][x]=mark

    enemy_heads={snakes[s][0] for s in opp_snakes if s in snakes}

    my_heads={snakes[s][0] for s in my_snakes if s in snakes}

    all_heads=enemy_heads|my_heads

    danger_map=build_danger_map(snakes)

    my_alive=[(sid,snakes[sid]) for sid in my_snakes if sid in snakes]

    my_alive.sort(key=lambda x:-len(x[1]))

    reserved_next=set()

    reserved_edges=set()

    assigned=set()

    actions=[]

    for sid,body in my_alive:

        sgrid=[row[:] for row in grid]

        for x,y in body:
            if 0<=x<width and 0<=y<height:
                sgrid[y][x]='.'

        avail=[t for t in power_sources if t not in assigned]

        move,reached=astar(body,avail,sgrid,danger_map,all_heads,reserved_next)

        if move:

            nh=next_head(body,move)

            if nh in reserved_next:
                move=None

            if (nh,body[0]) in reserved_edges:
                move=None

        if move is None:
            move=best_survival_move(body,sgrid,danger_map,all_heads,reserved_next)

        if move:

            nh=next_head(body,move)

            reserved_next.add(nh)

            reserved_edges.add((body[0],nh))

            if reached:
                assigned.add(reached)

            actions.append(f"{sid} {move}")

    print(";".join(actions) if actions else "WAIT")
